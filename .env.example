# ===================================================
# Smart College Complaint System - Environment Configuration
# Soch College of IT, Pokhara
# ===================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/smart_college_complaints

# Session Secret (Generate a strong 32+ character random string for production)
SESSION_SECRET=change-this-to-a-cryptographically-secure-random-string-min-32-chars

# Allowed Frontend Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Uploads Directory (Relative to project root or absolute path)
UPLOAD_DIR=uploads/attachments

# File Upload Limits
MAX_FILE_SIZE_BYTES=5242880 # 5 MB

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_SUBMISSIONS=10 # Max complaints per IP per window
RATE_LIMIT_MAX_TRACKING=30 # Max tracking lookups per IP per window
RATE_LIMIT_MAX_LOGINS=5 # Max admin login attempts per IP per window
