# =============================================================================
# Smart College Complaint System - Environment Configuration Template
# Soch College of IT, Pokhara
#
# IMPORTANT:
# - Copy this file to '.env' for local development.
# - On Render, enter these key-value pairs in: Service -> Environment.
# - NEVER commit your real '.env' file or production credentials to Git.
# =============================================================================

# Server Port (Render sets this automatically; default 5000 for local)
PORT=5000

# Node Environment: 'development' | 'production' | 'test'
# On Render, set this to 'production'.
NODE_ENV=development

# -----------------------------------------------------------------------------
# MongoDB Connection String (REQUIRED)
# -----------------------------------------------------------------------------
# Local MongoDB example:
# MONGODB_URI=mongodb://127.0.0.1:27017/smart_college_complaints
#
# MongoDB Atlas example (Standard production format):
# MONGODB_URI=mongodb+srv://<DB_USERNAME>:<ENCODED_PASSWORD>@cluster0.xxxx.mongodb.net/smart_college_complaints?retryWrites=true&w=majority
#
# CRITICAL ATLAS RULES:
# 1. Replace <DB_USERNAME> with your database user (e.g., dbAdmin).
# 2. Replace <ENCODED_PASSWORD> with the database user password.
#    - Do NOT leave it empty (e.g., username:@cluster... will cause "Password cannot be empty").
#    - Do NOT leave angle brackets < >.
# 3. If your password has special characters (@, :, /, ?, #, %, &, +), URL-encode them:
#    @ -> %40
#    : -> %3A
#    # -> %23
#    % -> %25
MONGODB_URI=mongodb://127.0.0.1:27017/smart_college_complaints

# -----------------------------------------------------------------------------
# Session Secret (REQUIRED in production)
# -----------------------------------------------------------------------------
# Generate a cryptographically secure random string with at least 32 characters.
# Example generator command: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-do-not-use-in-production-min-32-chars

# -----------------------------------------------------------------------------
# CORS Configuration (REQUIRED in production)
# -----------------------------------------------------------------------------
# The origin(s) of your frontend application without trailing slashes.
# Comma-separated if multiple (e.g. your Vercel preview or production domain).
# Example: https://smart-college-complaint.vercel.app
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Cookie Configuration (Optional - Defaults are auto-configured)
# -----------------------------------------------------------------------------
# In production, defaults to COOKIE_SAME_SITE=none and COOKIE_SECURE=true
# to support separated frontend (e.g. Vercel) and backend (e.g. Render) architectures.
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Uploads Directory & File Limits
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads/attachments
MAX_FILE_SIZE_BYTES=5242880 # 5 MB

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX_SUBMISSIONS=10 # Max complaints per window
RATE_LIMIT_MAX_TRACKING=30 # Max tracking lookups per window
RATE_LIMIT_MAX_LOGINS=5 # Max admin login attempts per window

# -----------------------------------------------------------------------------
# Initial Administrator Provisioning (Optional / Local only)
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@sochcollege.edu.np
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Campus IT Administrator

# -----------------------------------------------------------------------------
# Outbound Email Delivery (SMTP Configuration - Optional)
# -----------------------------------------------------------------------------
# If configured, used to send student email verifications and password reset tokens.
# If left empty, API falls back gracefully or returns 503 for email recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Soch College IT Grievance Portal" <noreply@sochcollege.edu.np>
